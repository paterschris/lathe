#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

# Determine architecture
version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

channel=$(<crates/zed/RELEASE_CHANNEL)

# Resolve app name from channel
case "$channel" in
    stable) app_name="Lathe.app" ;;
    preview) app_name="Lathe Preview.app" ;;
    beta) app_name="Lathe Beta.app" ;;
    nightly) app_name="Lathe Nightly.app" ;;
    dev) app_name="Lathe Dev.app" ;;
    *) app_name="Lathe Dev.app" ;;
esac

bundle_dir="target/${target_triple}/release/bundle/osx"
app_path="${bundle_dir}/${app_name}"

if [ ! -d "$app_path" ]; then
    # Try the non-target-triple path
    bundle_dir="target/release/bundle/osx"
    app_path="${bundle_dir}/${app_name}"
fi

if [ ! -d "$app_path" ]; then
    echo "Error: App bundle not found. Run 'script/build-fork' first."
    exit 1
fi

dest="/Applications/${app_name}"

echo "Installing ${app_name} to /Applications..."

if [ -d "$dest" ]; then
    echo "Removing existing ${app_name}..."
    rm -rf "$dest"
fi

cp -R "$app_path" "$dest"

# Sign with Developer ID if available (avoids TCC prompts for
# Documents/Desktop/Downloads), otherwise fall back to ad-hoc.
signing_identity="Developer ID Application: Chris Paterson (Z2DJF8UWJG)"
if security find-identity -v -p codesigning | grep -q "$signing_identity"; then
    echo "Signing ${app_name} with Developer ID..."
    codesign --force --deep --options runtime \
        --entitlements crates/zed/resources/zed.entitlements \
        --sign "$signing_identity" "$dest"
else
    echo "Developer ID not found, using ad-hoc signature..."
    if [ "$channel" != "dev" ]; then
        # Non-dev channels store credentials in the system keychain. An ad-hoc
        # signature has no Team ID and cannot read or write it, so the PR panel
        # shows "host not connected" and connecting an account fails with a
        # keychain error. This usually means the Developer ID key was not
        # unlocked in this shell (common for background/non-interactive runs).
        echo "" >&2
        echo "WARNING: ad-hoc signing a '${channel}' build; the system keychain will be" >&2
        echo "  inaccessible (PR panel auth and 'connect account' will fail). Re-run" >&2
        echo "  script/install-fork from an interactive Terminal, or re-sign with:" >&2
        echo "    codesign --force --deep --options runtime \\" >&2
        echo "      --entitlements crates/zed/resources/zed.entitlements \\" >&2
        echo "      --sign \"${signing_identity}\" \"${dest}\"" >&2
        echo "" >&2
    fi
    entitlements_tmp=$(mktemp)
    sed '/com.apple.developer.associated-domains/,+1d' \
        crates/zed/resources/zed.entitlements > "$entitlements_tmp"
    codesign --force --deep --entitlements "$entitlements_tmp" --sign - "$dest"
    rm -f "$entitlements_tmp"
fi
xattr -dr com.apple.quarantine "$dest" 2>/dev/null || true

# Symlink the CLI to a directory on PATH so `lathe` works in any terminal.
cli_src="${dest}/Contents/MacOS/cli"
cli_link="/usr/local/bin/lathe"
cli_link_dir="$(dirname "$cli_link")"

echo "Installing \`lathe\` CLI to ${cli_link}..."
if [ ! -d "$cli_link_dir" ]; then
    sudo mkdir -p "$cli_link_dir"
fi
if ! ln -sf "$cli_src" "$cli_link" 2>/dev/null; then
    sudo ln -sf "$cli_src" "$cli_link"
fi

# Clean up a stale /usr/local/bin/zed left behind by older Lathe builds
# (the in-app "Install CLI" action used to write `zed` instead of `lathe`).
# Only remove it if it points into a Lathe*.app — leave stock Zed alone.
if [ -L "/usr/local/bin/zed" ]; then
    zed_target=$(readlink "/usr/local/bin/zed")
    case "$zed_target" in
        */Lathe*.app/*)
            echo "Removing stale /usr/local/bin/zed (was -> ${zed_target})..."
            rm -f "/usr/local/bin/zed" 2>/dev/null || sudo rm -f "/usr/local/bin/zed"
            ;;
    esac
fi

echo ""
echo "=== Installed ==="
echo "  App: ${dest}"
echo "  CLI: ${cli_link}"
echo ""
echo "Launch from Spotlight or run:"
echo "  open \"${dest}\""
echo ""
echo "From any terminal:"
echo "  lathe ."
echo ""
echo "Note: This fork installs as '${app_name}' and runs alongside stock Zed."

if ! echo "$PATH" | tr ':' '\n' | grep -qx "$cli_link_dir"; then
    echo ""
    echo "Warning: ${cli_link_dir} is not on your PATH."
    echo "Add it with:"
    echo "  export PATH=\"${cli_link_dir}:\$PATH\""
fi
