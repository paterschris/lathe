#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

# --- Argument parsing ---
CLEAN_BUILD=false
for arg in "$@"; do
    case "$arg" in
        --clean) CLEAN_BUILD=true ;;
        -h|--help)
            cat <<'EOF'
Usage: script/build-fork [--clean]

  --clean    Wipe target/ before building, for a guaranteed from-scratch build.
  -h, --help Show this help.

Cached (incremental) builds are the default and stay fast. Because cargo never
garbage-collects target/, this script also auto-manages its size: once target/
exceeds LATHE_TARGET_SOFT_GB (default 80) it prunes always-regenerable cache
(incremental dirs + rust-analyzer's flycheck dirs); past LATHE_TARGET_HARD_GB
(default 200) it does a full reset. Set either cap to 0 to disable that tier.
EOF
            exit 0 ;;
        *) echo "Unknown argument: $arg (try --help)"; exit 1 ;;
    esac
done

# --- Storage management ---
# Cargo never garbage-collects target/, so across many upstream merges (each
# changing dependency hashes) plus rust-analyzer's separate check builds
# (target/debug + target/flycheck*), it can grow into the hundreds of GB. Keep
# cached builds fast, but bound growth: prune always-regenerable cache past a
# soft cap, and fully reset past a hard cap. Caps are whole GB; 0 disables.
target_size_gb() {
    [ -d target ] || { echo 0; return; }
    local kb
    kb=$(du -sk target 2>/dev/null | awk '{print $1}')
    echo $(( ${kb:-0} / 1024 / 1024 ))
}

manage_target_storage() {
    if [ "$CLEAN_BUILD" = true ]; then
        echo "Clean build requested — wiping target/ ..."
        cargo clean 2>/dev/null || rm -rf target
        return
    fi

    # Bare `return` would propagate the failed test's status and, under
    # `set -e`, abort the whole build on machines with no target/ yet
    # (fresh CI runners).
    [ -d target ] || return 0

    local soft_gb="${LATHE_TARGET_SOFT_GB:-80}"
    local hard_gb="${LATHE_TARGET_HARD_GB:-200}"
    local size_gb
    size_gb=$(target_size_gb)
    echo "target/ is currently ${size_gb} GB"

    if [ "$hard_gb" -gt 0 ] && [ "$size_gb" -ge "$hard_gb" ]; then
        echo "Exceeds hard cap (${hard_gb} GB) — full reset via cargo clean ..."
        cargo clean 2>/dev/null || rm -rf target
        return
    fi

    if [ "$soft_gb" -gt 0 ] && [ "$size_gb" -ge "$soft_gb" ]; then
        echo "Exceeds soft cap (${soft_gb} GB) — pruning regenerable cache ..."
        # incremental/ dirs and rust-analyzer's flycheck dir are always rebuilt
        # on demand; deleting them never breaks a build, only slows the next one.
        find target -type d -name incremental -prune -exec rm -rf {} + 2>/dev/null || true
        rm -rf target/flycheck* 2>/dev/null || true
        echo "Pruned to $(target_size_gb) GB"
    fi
}

echo "=== Building Lathe ==="

# --- Prerequisites ---

# 1. Xcode Command Line Tools
if ! xcode-select -p &>/dev/null; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
    echo "Please complete the installation dialog, then re-run this script."
    exit 1
fi

# 2. Xcode with Metal compiler
if ! xcrun --find metal &>/dev/null 2>&1; then
    if [ -d "/Applications/Xcode.app" ]; then
        echo "Selecting Xcode.app for Metal shader compilation..."
        sudo xcode-select -s /Applications/Xcode.app/Contents/Developer
    elif [ -d "/Applications/Xcode-beta.app" ]; then
        echo "Selecting Xcode-beta.app for Metal shader compilation..."
        sudo xcode-select -s /Applications/Xcode-beta.app/Contents/Developer
    else
        echo "Error: Xcode is required to build Lathe (for Metal shader compilation)."
        echo "Install Xcode from the App Store, then re-run this script."
        exit 1
    fi
fi

# 3. Metal Toolchain component
if ! xcrun metal -v &>/dev/null 2>&1; then
    echo "Installing Metal Toolchain..."
    xcodebuild -downloadComponent MetalToolchain
fi

# 2. Rust toolchain — install or repair from scratch if needed
install_rust() {
    echo "Installing Rust via rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    # Source the env that rustup just created
    if [ -f "$HOME/.cargo/env" ]; then
        # shellcheck disable=SC1091
        source "$HOME/.cargo/env"
    elif [ -d "$HOME/.cargo/bin" ]; then
        export PATH="$HOME/.cargo/bin:$PATH"
    fi
}

# Ensure cargo/rustc are on PATH from any prior install
if [ -f "$HOME/.cargo/env" ]; then
    # shellcheck disable=SC1091
    source "$HOME/.cargo/env"
elif [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

if ! command -v cargo &>/dev/null || ! command -v rustc &>/dev/null; then
    if command -v rustup &>/dev/null; then
        # rustup exists — try to resolve cargo through it
        cargo_bin=$(rustup which cargo 2>/dev/null || true)
        if [ -n "$cargo_bin" ]; then
            export PATH="$(dirname "$cargo_bin"):$PATH"
        else
            # Toolchain missing or broken — install it
            rustup toolchain install stable
            cargo_bin=$(rustup which cargo 2>/dev/null || true)
            if [ -n "$cargo_bin" ]; then
                export PATH="$(dirname "$cargo_bin"):$PATH"
            else
                # rustup is broken — reinstall everything
                install_rust
            fi
        fi
    else
        install_rust
    fi
fi

# Final check
if ! command -v cargo &>/dev/null || ! command -v rustc &>/dev/null; then
    echo "Error: Failed to install Rust. Please install manually:"
    echo "  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    exit 1
fi

# 4. Ensure cargo-bundle is installed (Zed's fork)
cargo_bundle_version=$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")
if [ "$cargo_bundle_version" != "cargo-bundle v0.6.1-zed" ]; then
    echo "Installing cargo-bundle..."
    cargo install cargo-bundle --git https://github.com/zed-industries/cargo-bundle.git --branch zed-deploy
fi

# Deal with versions of macOS that don't include libstdc++ headers
export CXXFLAGS="-stdlib=libc++"

# Determine architecture
version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

echo "Target: $target_triple"

# Bound target/ growth before kicking off the (cache-reusing) release build.
manage_target_storage

echo "Building release binary..."

cargo build --release --package zed --package cli --target "$target_triple"

echo "Creating application bundle..."
channel=$(<crates/zed/RELEASE_CHANNEL)

pushd crates/zed > /dev/null
cp Cargo.toml Cargo.toml.backup
sed -i.bak "s/package.metadata.bundle-${channel}/package.metadata.bundle/" Cargo.toml

export ZED_BUNDLE=true
export CARGO_BUNDLE_SKIP_BUILD=true
app_path=$(cargo bundle --release --target "$target_triple" --select-workspace-root | xargs)

mv Cargo.toml.backup Cargo.toml
rm -f Cargo.toml.bak
popd > /dev/null

# The cli binary is what /usr/local/bin/lathe symlinks to once installed.
# cargo bundle doesn't pick it up, so we copy it in alongside the main exe.
cp "target/${target_triple}/release/cli" "${app_path}/Contents/MacOS/cli"

echo ""
echo "=== Bundle created ==="
echo "  $app_path"
echo ""
echo "To install to /Applications:"
echo "  script/install-fork"
echo ""
echo "To run directly:"
echo "  open \"$app_path\""
